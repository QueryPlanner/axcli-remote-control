+/// Enable Chromium/Electron trees before attempting to walk them. Native apps are untouched.
+fn prepare_web_accessibility(pid: i32, element: &AXUIElement) {
+    use objc2_app_kit::NSRunningApplication;
+    let Some(app) = NSRunningApplication::runningApplicationWithProcessIdentifier(pid) else {
+        return;
+    };
+    let bundle = app.bundleIdentifier().map(|value| value.to_string().to_lowercase()).unwrap_or_default();
+    let browser = [
+        "com.brave.browser", "com.google.chrome", "org.chromium.chromium",
+        "com.microsoft.edgemac", "com.vivaldi.vivaldi", "com.operasoftware.opera",
+        "company.thebrowser.browser", "company.thebrowser.dia",
+    ].iter().any(|prefix| bundle.starts_with(prefix));
+    let electron = app.bundleURL().and_then(|url| url.path()).is_some_and(|path| {
+        std::path::Path::new(&path.to_string())
+            .join("Contents/Frameworks/Electron Framework.framework").is_dir()
+    });
+    if !browser && !electron {
+        return;
+    }
+    let yes = CFBoolean::new(true);
+    let attributes = ["AXManualAccessibility", "AXEnhancedUserInterface"];
+    let already_enabled = attributes.iter().any(|attribute| {
+        attr_value(element, attribute).is_some_and(|value| {
+            objc2_core_foundation::CFEqual(Some(value.as_ref()), Some(yes.as_ref()))
+        })
+    });
+    // Chromium can act on the request even while returning an unsupported-attribute error.
+    for attribute in attributes {
+        set_attr_value(element, attribute, yes);
+    }
+    if !already_enabled {
+        // The browser publishes its renderer tree asynchronously over IPC.
+        std::thread::sleep(std::time::Duration::from_millis(150));
+    }
+}
